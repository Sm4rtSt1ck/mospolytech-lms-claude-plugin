#!/usr/bin/env bash
# unitask from Claude's Bash tool (the plugin's bin/ is on that PATH; the user's terminals get the
# real binary through ~/.local/bin or the Windows user PATH). Claude uses it non-interactively:
#   unitask -get-file              path to progress.json in unitask's settings
#   unitask -set-file <path>       after moving progress.json (also update paths.progress_file)
set -euo pipefail

# The Bash tool does not receive CLAUDE_PLUGIN_DATA; find the data directory by its id prefix.
DATA="${CLAUDE_PLUGIN_DATA:-}"
if [[ -z "$DATA" ]]; then
  for d in "$HOME"/.claude/plugins/data/mospolytech-lms*; do
    if [[ -x "$d/unitask/unitask" || -x "$d/unitask/unitask.exe" ]]; then DATA="$d"; break; fi
  done
fi
exe="$DATA/unitask/unitask"
[[ -x "$exe" ]] || exe="$exe.exe"
[[ -n "$DATA" && -x "$exe" ]] || { echo "unitask: программа не установлена — перезапустите сессию Claude Code, чтобы плагин её скачал" >&2; exit 1; }

# Windows paths for the native binary when running under Git Bash.
args=()
for a in "$@"; do
  if [[ "$a" == /* ]] && command -v cygpath >/dev/null; then args+=("$(cygpath -w "$a")"); else args+=("$a"); fi
done
exec "$exe" ${args[@]+"${args[@]}"}
